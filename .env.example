# Copy to .env and configure on the server only. Never commit credentials.
PORT=3000
DATA_DIR=.data
# Set production for secure cookies and static build serving (HTTPS required).
# NODE_ENV=production
# Use either key name. CAUSE_AI_KEY supports cloud proxy credential bindings.
OPENAI_API_KEY=
# CAUSE_AI_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For proxy-managed cloud networking, Node 24 supports this opt-in:
# NODE_USE_ENV_PROXY=1
# Optional OpenAI-compatible trusted HTTPS endpoint, excluding /responses:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Enter your contracted model rates to enable cost estimates. No guessed pricing.
# CAUSE_INPUT_USD_PER_MILLION=
# CAUSE_OUTPUT_USD_PER_MILLION=
# Production anonymous demo and its AI budget are independently disabled by default.
# ENABLE_DEMO=true
# ALLOW_DEMO_AI=true
# Optional: exactly the trusted reverse-proxy hop count (never a blanket trust flag).
# TRUST_PROXY_HOPS=1
# Optional: externally managed encryption key; base64 of 32 random bytes.
# Otherwise a restricted DATA_DIR/.master-key is generated on first credential save.
# CAUSE_ENCRYPTION_KEY=
